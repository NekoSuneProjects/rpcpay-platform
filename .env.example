# RPCPay core
HOST=0.0.0.0
PORT=8080
DB_PATH=/app/data/rpcpay.db
CHAINS_CONFIG=/app/config/chains.json
HOT_WALLET_CONFIG=/app/config/hot-wallet.json
POLL_INTERVAL_MS=10000
INVOICE_EXPIRY_MINUTES=60
PUBLIC_CORS_ORIGIN=*
COOKIE_SECURE=true

# Generate independent random values, e.g. openssl rand -hex 32
API_KEY=CHANGE_ME
WEBHOOK_SECRET=CHANGE_ME
WALLET_ENCRYPTION_KEY=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# Fiat -> crypto pricing. This is market data only; neither provider handles the payment.
# auto: prefer NOWNodes Market Data when a key is configured, then fall back to CoinGecko.
# Other valid values: nownodes, coingecko
PRICE_PROVIDER=auto

# NOWNodes Market Data API: https://market-data.nownodes.io/api/v1/price
NOWNODES_MARKET_API_BASE=https://market-data.nownodes.io/api/v1
# If empty, RPCPay also tries NOWNODES_API_KEY below.
NOWNODES_MARKET_API_KEY=

# CoinGecko fallback / alternative
PRICE_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# EVM hot wallet portfolio shown in /admin -> Hot Wallet.
# Tracked networks/tokens are configured in HOT_WALLET_CONFIG independently from payment assets.
# Watch-only mode needs only an address and cannot sign transactions.
EVM_HOT_WALLET_ADDRESS=
# Optional signing mode. Use a dedicated hot-wallet key, never a treasury/cold-wallet key.
# If both address and key are set they must refer to the same EVM address.
EVM_HOT_WALLET_PRIVATE_KEY=

# Optional NOWNodes shared-node provider. Put the endpoints copied from your NOWNodes dashboard below.
# RPCPay sends NOWNODES_API_KEY as the server-side `api-key` request header.
NOWNODES_API_KEY=
ETH_NOWNODES_RPC_URL=
POLYGON_NOWNODES_RPC_URL=
BASE_NOWNODES_RPC_URL=
BNB_NOWNODES_RPC_URL=
TRON_NOWNODES_RPC_URL=
SOLANA_NOWNODES_RPC_URL=

# Optional TronGrid key used only when the TronGrid endpoint is selected.
TRONGRID_API_KEY=

# Token gas sponsors. Use small hot wallets with only enough native coin for token sweeps.
# Never use a treasury/cold-wallet private key here.
ETH_GAS_SPONSOR_PRIVATE_KEY=
POLYGON_GAS_SPONSOR_PRIVATE_KEY=
BASE_GAS_SPONSOR_PRIVATE_KEY=
BNB_GAS_SPONSOR_PRIVATE_KEY=
TRON_GAS_SPONSOR_PRIVATE_KEY=
# Solana: base64-encoded 64-byte Keypair secret key, or a JSON byte-array string.
SOLANA_GAS_SPONSOR_SECRET_KEY=

# Private wallet-RPC nodes for UTXO coins. These endpoints must expose wallet methods such as
# getnewaddress/listreceivedbyaddress/sendtoaddress. PublicNode/NOWNodes shared full-node RPCs are
# useful for chain reads and raw-transaction broadcast but are not a replacement for your wallet daemon.
BTC_RPC_URL=
BTC_RPC_USER=
BTC_RPC_PASSWORD=
DOGE_RPC_URL=
DOGE_RPC_USER=
DOGE_RPC_PASSWORD=
LTC_RPC_URL=
LTC_RPC_USER=
LTC_RPC_PASSWORD=
BCH_RPC_URL=
BCH_RPC_USER=
BCH_RPC_PASSWORD=
DASH_RPC_URL=
DASH_RPC_USER=
DASH_RPC_PASSWORD=
PIVX_RPC_URL=
PIVX_RPC_USER=
PIVX_RPC_PASSWORD=

# Bitcoin Lightning via your own LND node.
LND_REST_URL=
LND_MACAROON_HEX=
